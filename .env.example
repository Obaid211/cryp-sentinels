# ==============================================================================
# ECDAT — Enterprise Cryptographic Discovery & Analysis Tool
# Production & Local Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL in Docker / SQLite in local dev)
DATABASE_URL=postgresql://ecdat_user:ecdat_secure_password_2026@localhost:5432/ecdat_production
# For local SQLite development without PostgreSQL:
# DATABASE_URL=sqlite:///./ecdat.db

# Redis & Celery Message Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Gemini KeyPool Configuration (Optional: built-in expert engine serves as offline fallback)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

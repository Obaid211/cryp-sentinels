# =============================================================================
# ECDAT — Enterprise Cryptographic Discovery & Analysis Tool (SIH26164)
# Production & Deployment Environment Configuration
# =============================================================================

# -------------------------------------------------------------------
# Supabase Authentication (Vercel SPA & Frontend)
# Note: OAuth providers (Google, GitHub) are enabled in the Supabase Dashboard,
# not in code. Set the variables below in Vercel or your local .env.
# -------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:8000
VITE_AUTH_REDIRECT_URL=http://localhost:5173/

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# Local SQLite default:
DATABASE_URL=sqlite:///./ecdat.db
# Docker Compose PostgreSQL default:
# DATABASE_URL=postgresql://ecdat_user:your-db-password@postgres:5432/ecdat_production

# -------------------------------------------------------------------
# Redis & Celery Message Broker Configuration
# -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------
# Backend API & Security Configuration
# -------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
REQUIRE_AUTH=False
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -------------------------------------------------------------------
# Gemini KeyPool Configuration (AI Cryptographic Assistant)
# -------------------------------------------------------------------
GEMINI_API_KEYS=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# =============================================================================
# Live Hardware & Cloud KMS Scanners Configuration
# Leaving any group blank automatically keeps that scanner in offline mock mode.
# =============================================================================

# --- AWS Key Management Service (KMS) ---
# Note: Leaving this group blank keeps the AWS KMS scanner in offline mock mode.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=

# --- Azure Key Vault & Managed HSM ---
# Note: Leaving this group blank keeps the Azure Key Vault scanner in offline mock mode.
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# --- Google Cloud KMS ---
# Note: Leaving this group blank keeps the Google Cloud KMS scanner in offline mock mode.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Hardware Security Module (PKCS#11) ---
# Note: Leaving this group blank keeps the HSM scanner in offline mock mode.
PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
PKCS11_SLOT_ID=0
PKCS11_PIN=your-hsm-user-pin

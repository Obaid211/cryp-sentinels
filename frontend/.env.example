# ============================================================================
# ECDAT — Frontend Environment (Supabase Auth & API)
# ============================================================================
# Copy to .env for local dev:
#   cp .env.example .env
#
# For Vercel deployment, add these as `VITE_` prefixed variables in the
# Vercel project settings (masked/secrets). Never commit real keys.
#
# NOTE: OAuth providers (Google, GitHub) are configured and enabled in the
# Supabase Dashboard (Authentication -> Sign In / Providers), NOT in code.
# ============================================================================

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon public key (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (defaults to '' in production with reverse proxy or http://localhost:8000 in dev)
VITE_API_URL=http://localhost:8000

# Optional custom OAuth callback redirect URL (defaults to current window.location.origin)
# Useful when specifying explicit deployment origin e.g. https://your-domain.vercel.app/
VITE_AUTH_REDIRECT_URL=http://localhost:5173/

{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev -- --host 0.0.0.0 --port 5173",
  "regions": ["iad1", "sea1"],
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://<YOUR_BACKEND_DOMAIN>/api/$1"
    },
    {
      "src": "^(.*)$",
      "dest": "/index.html"
    }
  ]
}

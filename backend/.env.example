# =============================================================================
# ECDAT Backend Environment Configuration
# =============================================================================

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./ecdat.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://ecdat_user:your-db-password@localhost:5432/ecdat_production

# Redis & Celery Worker Broker
REDIS_URL=redis://localhost:6379/0

# Supabase Auth Verification (Zero-Trust Security Gate)
# When REQUIRE_AUTH=True, requests without a valid Bearer token will be rejected with 401
REQUIRE_AUTH=False
# JWT secret from Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Cryptographic Assistant (Gemini KeyPool)
# Multiple keys separated by commas for automatic rate-limit rotation
GEMINI_API_KEYS=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# =============================================================================
# Live Hardware & Cloud KMS Scanners Configuration
# Leaving any group blank automatically keeps that scanner in offline mock mode.
# =============================================================================

# --- AWS Key Management Service (KMS) ---
# Note: Leaving this group blank keeps the AWS KMS scanner in offline mock mode.
# AWS_REGION: Target AWS region for KMS API calls (defaults to us-east-1)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID: AWS access key ID for IAM user or service account
AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY: AWS secret access key paired with the access key ID
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN: Optional temporary security session token (e.g. for STS assumed roles)
AWS_SESSION_TOKEN=

# --- Azure Key Vault & Managed HSM ---
# Note: Leaving this group blank keeps the Azure Key Vault scanner in offline mock mode.
# AZURE_KEY_VAULT_URL: Full HTTPS URL of the Azure Key Vault or Managed HSM
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
# AZURE_TENANT_ID: Azure Active Directory / Entra tenant ID
AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_CLIENT_ID: Azure service principal application client ID
AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET: Azure service principal password / client secret
AZURE_CLIENT_SECRET=your-azure-client-secret

# --- Google Cloud KMS ---
# Note: Leaving this group blank keeps the Google Cloud KMS scanner in offline mock mode.
# GOOGLE_APPLICATION_CREDENTIALS: Absolute disk path to Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Hardware Security Module (PKCS#11) ---
# Note: Leaving this group blank keeps the HSM scanner in offline mock mode.
# PKCS11_MODULE_PATH: Absolute path to the vendor PKCS#11 shared library (.so on Linux, .dll on Windows)
PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# PKCS11_SLOT_ID: Hardware slot or token index to probe (defaults to 0)
PKCS11_SLOT_ID=0
# PKCS11_PIN: Security PIN or passphrase for authenticated token operations
PKCS11_PIN=your-hsm-user-pin
